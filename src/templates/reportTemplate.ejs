<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TTS-GSOC Monthly Report</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #ffffff; /* ✅ pure white background */
        padding: 20px;
        color: #333;
      }

      .report-container {
        width: 100%;
        max-width: 1800px; /* ✅ Wide layout for landscape */
        margin: 0 auto;
        background-color: white;
        padding: 30px;
        border-radius: 8px;
        box-shadow: none; /* ✅ Removed gray shadow border */
        overflow: visible;
      }

      .header-title {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 2px solid #3498db;
      }

      .section-title {
        font-size: 22px;
        font-weight: 600;
        color: #2c3e50;
        margin-top: 30px;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e0e0e0;
      }

      .summary-box {
        background-color: #f8f9fa;
        border-left: 4px solid #3498db;
        padding: 20px;
        margin-bottom: 30px;
        border-radius: 4px;
        page-break-inside: avoid;
      }

      /* New style for date range and summary */
      .date-range-summary {
        background-color: #f0f7ff;
        border-left: 4px solid #5c9eff;
        padding: 15px 20px;
        margin-bottom: 20px;
        border-radius: 4px;
        page-break-inside: avoid;
      }

      .date-range {
        font-weight: 600;
        color: #2c3e50;
        font-size: 16px;
        margin-bottom: 8px;
      }

      .date-summary {
        color: #555;
        font-size: 14px;
      }

      /* ✅ Two-chart layout, side-by-side, no clipping */
      .grid-row {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
        gap: 20px;
        margin-bottom: 25px;
        page-break-inside: avoid;
      }

      .grid-cell {
        flex: 1 1 48%;
        background: #fff;
        border-radius: 6px;
        padding: 10px;
        box-sizing: border-box;
        page-break-inside: avoid;
        overflow: visible;
      }

      .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 10px;
        text-align: center;
      }

      .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
        page-break-inside: avoid;
        overflow: visible;
      }

      .table-container {
        margin-top: 20px;
        margin-bottom: 30px;
        overflow-x: auto;
        page-break-inside: avoid;
      }

      .table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }

      .table th,
      .table td {
        border: 1px solid #ddd;
        padding: 8px 10px;
        text-align: center;
        /* Changed from nowrap to allow word wrapping */
        white-space: normal;
        word-wrap: break-word;
        max-width: 200px;
      }

      .table th {
        background-color: #3498db;
        color: white;
      }

      .footer {
        margin-top: 40px;
        text-align: center;
        font-size: 12px;
        color: #777;
      }

      /* ✅ Print rules (A4 Landscape, no cutoff, no gray border) */
      @media print {
        html,
        body {
          width: 297mm;
          height: 210mm;
          -webkit-print-color-adjust: exact;
          overflow: visible !important;
          background: white !important;
        }

        .report-container {
          box-shadow: none !important;
          margin: 0;
          padding: 15mm; /* Reduced padding to fit more content */
          overflow: visible;
          background: white !important;
        }

        .grid-row {
          flex-direction: row;
          flex-wrap: nowrap;
        }

        .grid-cell {
          flex: 1 1 48%;
          width: 48%;
          margin: 0 1%;
          page-break-inside: avoid;
          overflow: visible;
        }

        .chart-container {
          height: 250px; /* Slightly reduced height */
          overflow: visible;
        }

        .summary-box,
        .table-container,
        .date-range-summary {
          page-break-inside: avoid;
        }

        /* Table adjustments for print */
        .table {
          font-size: 12px; /* Slightly smaller font for tables */
        }

        .table th,
        .table td {
          padding: 6px 8px; /* Reduced padding */
          white-space: normal;
          word-wrap: break-word;
          max-width: 150px; /* Adjusted max width for print */
        }

        /* Ensure section titles don't get separated from their content */
        .section-title {
          page-break-after: avoid;
          page-break-inside: avoid;
        }

        /* Page break handling */
        .page-break {
          page-break-before: always;
        }

        /* Ensure chart titles stay with their charts */
        .chart-title {
          page-break-after: avoid;
        }
      }
    </style>
  </head>
  <body>
    <div class="report-container">
      <!-- 1st row: Header -->
      <div class="header-title">
        TTS-GSOC - Monthly Report of <%= reportMonth %>
      </div>

      <!-- 2nd row: Executive Summary Title -->
      <div class="section-title">Executive Summary</div>

      <!-- 3rd row: Executive Summary Box -->
      <div class="summary-box">
        <p>
          This executive summary covers the security operations for <%=
          reportMonth %>. The Global Security Operations Center has been
          actively monitoring and responding to security incidents across all
          affiliates. This month saw a total of 245 incidents, with 12 high
          severity incidents that required immediate attention. The majority of
          incidents were detected through our automated monitoring systems, with
          a 15% increase in detection rate compared to the previous month. Our
          team has successfully resolved 92% of all incidents within the SLA
          timeframe.
        </p>
      </div>

      <!-- 4th row: Incident Management Title -->
      <div class="section-title">Incident Management</div>

      <!-- 5th row: Incident Titles (Row 1) -->
      <div class="grid-row">
        <div class="grid-cell">
          <div class="chart-title">Incident by Severity</div>
        </div>
        <div class="grid-cell">
          <div class="chart-title">Incident by Detection Source</div>
        </div>
      </div>

      <!-- 6th row: Incident Charts (Row 2) -->
      <div class="grid-row">
        <div class="grid-cell">
          <div class="chart-container">
            <canvas id="severityChart"></canvas>
          </div>
        </div>
        <div class="grid-cell">
          <div class="chart-container">
            <canvas id="detectionChart"></canvas>
          </div>
        </div>
      </div>

      <!-- 7th row: Incident Tables (Row 3) -->
      <div class="grid-row">
        <div class="grid-cell">
          <div class="table-container">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th>Affiliate</th>
                  <th>High</th>
                  <th>Medium</th>
                  <th>Low</th>
                </tr>
              </thead>
              <tbody>
                <% incidentSeverityData.forEach(function(item) { %>
                <tr>
                  <td><%= item.affiliate %></td>
                  <td><%= item.high %></td>
                  <td><%= item.medium %></td>
                  <td><%= item.low %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="grid-cell">
          <div class="table-container">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th>Affiliate</th>
                  <% detectionSources.forEach(function(source) { %>
                  <th><%= source %></th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <% incidentDetectionData.forEach(function(item) { %>
                <tr>
                  <td><%= item.affiliate %></td>
                  <% detectionSources.forEach(function(source) { %>
                  <td><%= item[source] || 0 %></td>
                  <% }); %>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 8th row: Handling Status Titles (Row 1) -->
      <div class="grid-row">
        <div class="grid-cell">
          <div class="chart-title">Incident by Handling Status</div>
        </div>
        <div class="grid-cell">
          <div class="chart-title">Incident by Sub Status</div>
        </div>
      </div>

      <!-- 9th row: Handling Status Charts (Row 2) -->
      <div class="grid-row">
        <div class="grid-cell">
          <div class="chart-container">
            <canvas id="handlingStatusChart"></canvas>
          </div>
        </div>
        <div class="grid-cell">
          <div class="chart-container">
            <canvas id="subStatusChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Page break before ticket analysis -->
      <div class="page-break"></div>

      <!-- 10th row: Analysis on Incident Ticket Title -->
      <div class="section-title">Analysis on Incident Ticket</div>

      <!-- New: Date Range and Summary for Incident Tickets -->
      <div class="date-range-summary">
        <div class="date-range">1 November 25-30 November 25</div>
        <div class="date-summary">During this period, our team handled 45 incident tickets with a 95% resolution rate within SLA.</div>
      </div>

      <!-- 11th row: Incident Ticket Table -->
      <div class="table-container">
        <table class="table table-striped table-bordered">
          <thead>
            <tr>
              <th>Ticket ID</th>
              <th>Date</th>
              <th>Affiliate</th>
              <th>Severity</th>
              <th>Status</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% incidentTickets.forEach(function(ticket) { %>
            <tr>
              <td><%= ticket.id %></td>
              <td><%= ticket.date %></td>
              <td><%= ticket.affiliate %></td>
              <td><%= ticket.severity %></td>
              <td><%= ticket.status %></td>
              <td><%= ticket.description %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- 12th row: Analysis on Health Ticket Title -->
      <div class="section-title">Analysis on Health Ticket</div>

      <!-- New: Date Range and Summary for Health Tickets -->
      <div class="date-range-summary">
        <div class="date-range">1 November 25-30 November 25</div>
        <div class="date-summary">System health monitoring identified 28 issues requiring attention, with 100% resolved within the target timeframe.</div>
      </div>

      <!-- 13th row: Health Ticket Table -->
      <div class="table-container">
        <table class="table table-striped table-bordered">
          <thead>
            <tr>
              <th>Ticket ID</th>
              <th>Date</th>
              <th>Affiliate</th>
              <th>System</th>
              <th>Status</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% healthTickets.forEach(function(ticket) { %>
            <tr>
              <td><%= ticket.id %></td>
              <td><%= ticket.date %></td>
              <td><%= ticket.affiliate %></td>
              <td><%= ticket.system %></td>
              <td><%= ticket.status %></td>
              <td><%= ticket.description %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Footer -->
      <div class="footer">
        Generated automatically on <%= new Date().toLocaleString() %>
      </div>
    </div>

    <!-- Hidden data containers for chart data -->
    <script type="application/json" id="severityChartLabels">
      <%- JSON.stringify(severityChartLabels) %>
    </script>
    <script type="application/json" id="severityChartData">
      <%- JSON.stringify(severityChartData) %>
    </script>
    <script type="application/json" id="detectionChartLabels">
      <%- JSON.stringify(detectionChartLabels) %>
    </script>
    <script type="application/json" id="detectionChartData">
      <%- JSON.stringify(detectionChartData) %>
    </script>
    <!-- Fixed variable names to match what's used in the JavaScript -->
    <script type="application/json" id="handlingStatusChartLabels">
      <%- JSON.stringify(handlingStatusChartLabels) %>
    </script>
    <script type="application/json" id="handlingStatusChartData">
      <%- JSON.stringify(handlingStatusChartData) %>
    </script>
    <script type="application/json" id="subStatusChartLabels">
      <%- JSON.stringify(subStatusChartLabels) %>
    </script>
    <script type="application/json" id="subStatusChartData">
      <%- JSON.stringify(subStatusChartData) %>
    </script>
    <!-- Add colors for sub-status chart -->
    <script type="application/json" id="subStatusColors">
      <%- JSON.stringify(subStatusColors) %>
    </script>

<script>
  // Function to safely parse JSON from script tags
  function getChartData(elementId) {
    try {
      const element = document.getElementById(elementId);
      if (element) {
        const data = JSON.parse(element.textContent);
        console.log(`📊 ${elementId} data:`, data);
        return data;
      }
      return null;
    } catch (error) {
      console.error("Error parsing chart data:", error);
      return null;
    }
  }

  // Get data from hidden script tags
  const severityChartLabels = getChartData("severityChartLabels");
  const severityChartData = getChartData("severityChartData");
  const detectionChartLabels = getChartData("detectionChartLabels");
  const detectionChartData = getChartData("detectionChartData");
  // Fixed variable names to match the script tag IDs
  const handlingStatusChartLabels = getChartData("handlingStatusChartLabels");
  const handlingStatusChartData = getChartData("handlingStatusChartData");
  const subStatusChartLabels = getChartData("subStatusChartLabels");
  const subStatusChartData = getChartData("subStatusChartData");
  const subStatusColors = getChartData("subStatusColors");

  // Function to create charts
  function createCharts() {
    // Only create charts if data is available
    if (!severityChartLabels || !severityChartData) {
      console.error("Missing severity chart data");
      return;
    }

    console.log("📊 Creating severity chart with labels:", severityChartLabels);
    console.log("📊 Creating severity chart with data:", severityChartData);

    // Custom plugin to draw data labels
    const dataLabelsPlugin = {
      id: 'dataLabels',
      afterDatasetsDraw: function(chart) {
        const ctx = chart.ctx;
        ctx.save();
        
        chart.data.datasets.forEach(function(dataset, i) {
          const meta = chart.getDatasetMeta(i);
          if (!meta.hidden) {
            meta.data.forEach(function(element, index) {
              // Draw the data value on top of each bar
              const data = dataset.data[index];
                ctx.fillStyle = '#304758';
                ctx.font = '500 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';
                
            const barTopY = element.y; // top of the bar
const barCenterX = element.x; // center X position

ctx.fillStyle = '#304758';
ctx.font = '500 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
ctx.textAlign = 'center';
ctx.textBaseline = 'bottom';

// Always show the value, even for 0
ctx.fillText(data, barCenterX, barTopY - 6);

            });
          }
        });
        
        ctx.restore();
      }
    };

    // Register the plugin
    Chart.register(dataLabelsPlugin);

    // Incident by Severity Chart (Bar) - Updated to match frontend styling
    const severityCtx = document.getElementById("severityChart");
    if (severityCtx) {
      const severityChart = new Chart(severityCtx.getContext("2d"), {
        type: "bar",
        data: {
          labels: severityChartLabels,
          datasets: [
            {
              label: "High",
              data: severityChartData.high,
              backgroundColor: "#f08080", // Red for High (matching frontend)
              barPercentage: 0.6,
              categoryPercentage: 0.7
            },
            {
              label: "Medium",
              data: severityChartData.medium,
              backgroundColor: "#ffdd57", // Yellow for Medium (matching frontend)
              barPercentage: 0.6,
              categoryPercentage: 0.7
            },
            {
              label: "Low",
              data: severityChartData.low,
              backgroundColor: "#66b2ff", // Blue for Low (matching frontend)
              barPercentage: 0.6,
              categoryPercentage: 0.7
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 0 // Disable animation for PDF generation
          },
          plugins: {
            legend: {
              position: 'bottom',
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.dataset.label + ': ' + context.raw + ' incidents';
                }
              }
            }
          },
          scales: {
            x: {
              stacked: false,
            },
            y: {
              stacked: false,
              beginAtZero: true,
              title: {
                display: true,
                text: 'Incident Count'
              },
              // Ensure there's enough space for the labels
              ticks: {
                padding: 10
              }
            }
          }
        },
      });
      
      console.log("📊 Severity chart created:", severityChart);
    }

    // Incident by Detection Source Chart (Bar)
    const detectionCtx = document.getElementById("detectionChart");
    if (detectionCtx && detectionChartLabels && detectionChartData) {
      new Chart(detectionCtx.getContext("2d"), {
        type: "bar",
        data: {
          labels: detectionChartLabels,
          datasets: [
            {
              label: "Incidents",
              data: detectionChartData,
              backgroundColor: "rgba(85,110,230,1)", // Updated to single color as requested
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 0 // Disable animation for PDF generation
          },
          scales: {
            y: {
              beginAtZero: true,
            },
          },
        },
      });
    }
    
    // Incident by Handling Status Chart (Bar)
    const handlingStatusCtx = document.getElementById("handlingStatusChart");
    if (handlingStatusCtx && handlingStatusChartLabels && handlingStatusChartData) {
      new Chart(handlingStatusCtx.getContext("2d"), {
        type: "bar",
        data: {
          labels: handlingStatusChartLabels,
          datasets: [
            {
              label: "Open",
              data: handlingStatusChartData.open,
              backgroundColor: "#f08080",
            },
            {
              label: "Pending",
              data: handlingStatusChartData.pending,
              backgroundColor: "#ffdd57",
            },
            {
              label: "Resolved",
              data: handlingStatusChartData.resolved,
              backgroundColor: "#70db70",
            },
            {
              label: "Closed",
              data: handlingStatusChartData.closed,
              backgroundColor: "#66b2ff",
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 0 // Disable animation for PDF generation
          },
          scales: {
            x: {
              stacked: false,
            },
            y: {
              stacked: false,
              beginAtZero: true,
            },
          },
        },
      });
    }

    // Incident by Sub Status Chart (Bar) - Updated to match frontend implementation
    const subStatusCtx = document.getElementById("subStatusChart");
    if (subStatusCtx && subStatusChartLabels && subStatusChartData) {
      console.log("📊 Creating sub-status chart with labels:", subStatusChartLabels);
      console.log("📊 Creating sub-status chart with data:", subStatusChartData);
      console.log("📊 Creating sub-status chart with colors:", subStatusColors);
      
      new Chart(subStatusCtx.getContext("2d"), {
        type: "bar",
        data: {
          labels: subStatusChartLabels,
          datasets: [
            {
              label: "Incidents",
              data: subStatusChartData,
              backgroundColor: subStatusColors, // Use colors from backend
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 0 // Disable animation for PDF generation
          },
          scales: {
            y: {
              beginAtZero: true,
            },
          },
        },
      });
    }
  }

  // Create charts when DOM is loaded
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", createCharts);
  } else {
    createCharts();
  }
</script>
  </body>
</html>
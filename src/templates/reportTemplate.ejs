<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= customerDisplayName %> Monthly Report
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background-color: #ffffff;
      padding: 20px;
      color: #333;
    }

    .report-container {
      width: 100%;
      max-width: 1800px;
      margin: 0 auto;
      background-color: white;
      padding: 30px;
      border-radius: 8px;
      box-shadow: none;
      overflow: visible;
    }

    .header-title {
      text-align: center;
      font-size: 28px;
      font-weight: bold;
      color: #2c3e50;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 2px solid #3498db;
    }

    .section-title {
      font-size: 22px;
      font-weight: 600;
      color: #2c3e50;
      margin-top: 30px;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 1px solid #e0e0e0;
    }

    .summary-box {
      background-color: #e6f2ff;
      /* Changed from #f8f9fa to #e6f2ff */
      border-left: 4px solid #3498db;
      padding: 0 20px 20px 20px;
      margin-bottom: 30px;
      border-radius: 4px;
      page-break-inside: avoid;
    }

    .date-range-summary {
      background-color: #e6f2ff;
      /* Made darker by reducing opacity */
      border-left: 4px solid #5c9eff;
      padding: 15px 20px;
      margin-bottom: 20px;
      border-radius: 4px;
      page-break-inside: avoid;
    }

    .date-range {
      font-weight: 600;
      color: #2c3e50;
      font-size: 16px;
      margin-bottom: 8px;
    }

    .date-summary {
      color: #555;
      font-size: 14px;
    }

    .grid-row {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: stretch;
      gap: 20px;
      margin-bottom: 15px;
      /* Reduced from 25px to 15px */
      page-break-inside: avoid;
    }

    .grid-cell {
      flex: 1 1 48%;
      background: #fff;
      border-radius: 6px;
      padding: 5px;
      /* Reduced from 10px to 5px */
      box-sizing: border-box;
      page-break-inside: avoid;
      overflow: visible;
    }

    .chart-title {
      font-size: 18px;
      font-weight: 600;
      color: #2c3e50;
      margin-bottom: 5px;
      /* Reduced from 10px to 5px */
      text-align: center;
    }

    .chart-container {
      position: relative;
      height: 400px;
      /* Consistent height for all charts */
      width: 100%;
      page-break-inside: avoid;
      overflow: visible;
    }

    .table-container {
      margin-top: 20px;
      margin-bottom: 30px;
      overflow-x: auto;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      font-size: 16px;
      /* Increased from 14px to 16px for better readability */
      table-layout: auto;
    }

    .table th,
    .table td {
      border: 1px solid #ddd;
      padding: 8px 10px;
      text-align: center;
      white-space: normal;
      word-wrap: break-word;
      vertical-align: middle;
      /* Changed from top to middle for vertical centering */
    }

    /* Enhanced word wrapping for table headers */
    .table th {
      background-color: #3498db;
      color: white;
      white-space: normal;
      word-wrap: break-word;
      word-break: break-word;
      hyphens: auto;
      overflow-wrap: break-word;
      max-width: 100px;
      /* Set a max-width to force wrapping */
      height: auto;
      /* Allow height to adjust */
      min-height: 40px;
      /* Minimum height for better appearance */
    }

    /* Make SOC Analysis column wider */
    .table th:nth-child(6),
    .table td:nth-child(6) {
      min-width: 200px;
      width: 25%;
    }

    /* Make SOC Recommendation column half width of SOC Analysis */
    .table th:nth-child(7),
    .table td:nth-child(7) {
      min-width: 100px;
      width: 12.5%;
      /* Half of previous 25% width */
    }

    /* Make other columns narrower */
    .table th:not(:nth-child(6)):not(:nth-child(7)),
    .table td:not(:nth-child(6)):not(:nth-child(7)) {
      min-width: 80px;
      width: auto;
    }

    /* Make executive summary and analysis content bold */
    .summary-box p,
    .date-range-summary {
      font-weight: bold;
    }

    /* Print header and footer */
    @media print {
      @page {
        margin: 15mm 10mm 15mm 10mm;
        size: A4;
      }

      .print-header {
        position: fixed;
        top: 0;
        right: 0;
        width: 100%;
        text-align: right;
        font-size: 12px;
        font-weight: normal;
        color: #2c3e50;
        padding: 5px 15px;
      }

      .print-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 20px;
        text-align: center;
        font-size: 10px;
        color: #777;
        padding: 5px 0;
        border-top: 1px solid #ddd;
      }

      html,
      body {
        width: 297mm;
        height: 210mm;
        -webkit-print-color-adjust: exact;
        overflow: visible !important;
        background: white !important;
      }

      .report-container {
        box-shadow: none !important;
        margin: 0;
        padding: 15mm 10mm 20mm 10mm;
        overflow: visible;
        background: white !important;
        max-width: 100%;
      }

      .grid-row {
        flex-direction: row;
        flex-wrap: nowrap;
      }

      .grid-cell {
        flex: 1 1 48%;
        width: 48%;
        margin: 0 1%;
        page-break-inside: avoid;
        overflow: visible;
      }

      .chart-container {
        height: 350px;
        /* Consistent height for all charts in print */
        overflow: visible;
      }

      /* More aggressive table styling for print */
      .table {
        font-size: 11px;
        /* Increased from 9px to 11px for better readability */
        table-layout: fixed;
        width: 100%;
        max-width: 100%;
      }

      .table th,
      .table td {
        padding: 3px 4px;
        white-space: normal;
        word-wrap: break-word;
        vertical-align: middle;
        /* Changed from top to middle for vertical centering */
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Enhanced word wrapping for print headers */
      .table th {
        white-space: normal;
        word-wrap: break-word;
        word-break: break-word;
        hyphens: auto;
        overflow-wrap: break-word;
        height: auto;
        min-height: 30px;
        /* Smaller min-height for print */
      }

      /* More specific column widths for print */
      .table th:nth-child(1),
      /* Incident Number */
      .table td:nth-child(1) {
        width: 8%;
      }

      .table th:nth-child(2),
      /* Incident Name */
      .table td:nth-child(2) {
        width: 12%;
      }

      .table th:nth-child(3),
      /* Incident Time */
      .table td:nth-child(3) {
        width: 10%;
      }

      .table th:nth-child(4),
      /* Incident Severity */
      .table td:nth-child(4) {
        width: 8%;
      }

      .table th:nth-child(5),
      /* Incident Type */
      .table td:nth-child(5) {
        width: 10%;
      }

      .table th:nth-child(6),
      /* SOC Analysis */
      .table td:nth-child(6) {
        width: 25%;
      }

      .table th:nth-child(7),
      /* SOC Recommendation - reduced by half */
      .table td:nth-child(7) {
        width: 12.5%;
        /* Half of previous 25% width */
      }

      .table th:nth-child(8),
      /* Incident Status */
      .table td:nth-child(8) {
        width: 9.5%;
        /* Increased from 7% to compensate for reduced column 7 */
      }

      .table th:nth-child(9),
      /* Incident SubStatus */
      .table td:nth-child(9) {
        width: 7%;
        /* Increased from 5% to compensate for reduced column 7 */
      }

      /* Health table specific widths - SAME AS INCIDENT TABLE */
      #healthTable th:nth-child(1),
      /* Ticket ID */
      #healthTable td:nth-child(1) {
        width: 8%;
      }

      #healthTable th:nth-child(2),
      /* Subject */
      #healthTable td:nth-child(2) {
        width: 12%;
      }

      #healthTable th:nth-child(3),
      /* Date */
      #healthTable td:nth-child(3) {
        width: 10%;
      }

      #healthTable th:nth-child(4),
      /* Affiliate */
      #healthTable td:nth-child(4) {
        width: 8%;
      }

      #healthTable th:nth-child(5),
      /* System */
      #healthTable td:nth-child(5) {
        width: 10%;
      }

      #healthTable th:nth-child(6),
      /* Status */
      #healthTable td:nth-child(6) {
        width: 25%;
      }

      #healthTable th:nth-child(7),
      /* Description */
      #healthTable td:nth-child(7) {
        width: 12.5%;
      }

      #healthTable th:nth-child(8),
      /* Status */
      #healthTable td:nth-child(8) {
        width: 9.5%;
      }

      #healthTable th:nth-child(9),
      /* Description */
      #healthTable td:nth-child(9) {
        width: 7%;
      }

      .table thead {
        display: table-header-group;
      }

      .table tfoot {
        display: table-footer-group;
      }

      .table tr {
        page-break-inside: avoid;
        page-break-after: auto;
      }

      .table td {
        page-break-inside: avoid;
        vertical-align: middle;
        /* Changed from top to middle for vertical centering */
      }

      .section-title {
        page-break-after: avoid;
        page-break-inside: avoid;
        margin-top: 20px;
        margin-bottom: 10px;
      }

      .summary-box,
      .date-range-summary {
        page-break-inside: avoid;
      }

      .table-container {
        page-break-inside: auto;
        orphans: 4;
        widows: 4;
        overflow-x: hidden;
        width: 100%;
      }

      .page-break {
        page-break-before: always;
      }

      .no-page-break {
        page-break-inside: avoid;
      }

      .chart-title {
        page-break-after: avoid;
      }

      .grid-row {
        margin-bottom: 10px;
        /* Reduced from 15px to 10px */
      }

      .table-container {
        margin-top: 10px;
        margin-bottom: 15px;
      }
    }

    .footer {
      margin-top: 40px;
      text-align: center;
      font-size: 12px;
      color: #777;
    }

    .table-page-break {
      page-break-after: always;
    }

    .no-break-after {
      page-break-after: auto;
    }
  </style>
</head>

<body>
  <!-- Print Header -->
  <div class="print-header">
    Created by SOC Watchtower<br>
    <span id="generationDateTime"></span>
  </div>

  <!-- Print Footer -->

  <div class="print-footer">
    © <%= new Date().getFullYear() %> SOC-Watchtower. All Rights Reserved to Toyota Tsusho Systems Thailand Co. Ltd.
  </div>

  <div class="report-container">
    <!-- 1st row: Header -->
    <div class="header-title">
      <%= customerDisplayName %> Monthly Report of <%= reportMonth %>
    </div>

    <!-- 2nd row: Executive Summary Title -->
    <div class="section-title">Executive Summary</div>

    <!-- 3rd row: Executive Summary Box -->
    <div class="summary-box">
      <p style="white-space: pre-line; margin-top: 0; margin-bottom: 0;">
        <%= executiveSummary %>
      </p>
    </div>

    <!-- 4th row: Incident Management Title -->
    <div class="section-title">Incident Management</div>

    <!-- 5th row: Incident Titles (Row 1) -->
    <div class="grid-row">
      <div class="grid-cell">
        <div class="chart-title">Incident by Severity</div>
      </div>
      <div class="grid-cell">
        <div class="chart-title">Incident by Detection Source</div>
      </div>
    </div>

    <!-- 6th row: Incident Charts (Row 2) -->
    <div class="grid-row">
      <div class="grid-cell">
        <div class="chart-container">
          <canvas id="severityChart"></canvas>
        </div>
      </div>
      <div class="grid-cell">
        <div class="chart-container">
          <canvas id="detectionChart"></canvas>
        </div>
      </div>
    </div>

    <!-- 7th row: Incident Tables (Row 3) -->
  <div class="grid-row">
  <div class="grid-cell">
    <div class="table-container">
      <table class="table table-bordered" style="margin-top: 20px;">
        <thead>
          <tr>
            <th>Affiliate</th>
            <th>High</th>
            <th>Medium</th>
            <th>Low</th>
          </tr>
        </thead>
        <tbody>
          <% incidentSeverityData.forEach(function(item) { %>
            <tr>
              <td><%= item.affiliate %></td>
              <td><%= item.high %></td>
              <td><%= item.medium %></td>
              <td><%= item.low %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="grid-cell">
    <div class="table-container">
      <table class="table table-bordered" style="margin-top: 20px">
        <thead>
          <tr>
            <th>Affiliate</th>
            <%
              // Always define tableDetectionSources for the table
              const tableDetectionSources = (detectionSources && detectionSources.length > 0)
                ? detectionSources
                : ['Active Directory', 'MDE', 'Entra ID', 'Firewall', 'O365'];
            %>
            <% tableDetectionSources.forEach(function(source) { %>
              <th><%= source %></th>
            <% }); %>
          </tr>
        </thead>
        <%
          // SAFELY define tableDetectionData here
          const safeIncidentDetectionData = Array.isArray(incidentDetectionData) ? incidentDetectionData : [];
          const tableDetectionData = safeIncidentDetectionData.map(function(item) {
            const newItem = { affiliate: item.affiliate || 'N/A' };
            tableDetectionSources.forEach(function(source) {
              newItem[source] = item[source] || 0;
            });
            return newItem;
          });
        %>
        <tbody>
          <% if (tableDetectionData.length === 0) { %>
            <tr>
              <td>N/A</td>
              <% tableDetectionSources.forEach(function(source) { %>
                <td>0</td>
              <% }); %>
            </tr>
          <% } else { %>
            <% tableDetectionData.forEach(function(item) { %>
              <tr>
                <td><%= item.affiliate %></td>
                <% tableDetectionSources.forEach(function(source) { %>
                  <td><%= item[source] || 0 %></td>
                <% }); %>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

    <!-- 8th row: Handling Status Titles (Row 1) -->
    <div class="grid-row">
      <div class="grid-cell">
        <div class="chart-title">Incident by Handling Status</div>
      </div>
      <div class="grid-cell">
        <div class="chart-title">Incident by Sub Status</div>
      </div>
    </div>

    <!-- 9th row: Handling Status Charts (Row 2) -->
    <div class="grid-row">
      <div class="grid-cell">
        <div class="chart-container">
          <canvas id="handlingStatusChart"></canvas>
        </div>
      </div>
      <div class="grid-cell">
        <div class="chart-container">
          <canvas id="subStatusChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Page break before ticket analysis -->
    <div class="page-break"></div>

    <!-- 10th row: Analysis on Incident Ticket Title -->
    <div class="section-title">Analysis on Incident Ticket</div>

    <!-- New: Summary for Incident Tickets (without date range) -->
    <div class="date-range-summary">
      <div class="date-summary"><%- incidentTicketSummary || `During this period, our team handled
          ${incidentTickets.length} incident tickets with customer escalation.` %></div>
    </div>

    <% if (incidentTickets && incidentTickets.length> 0) { %>
      <!-- 11th row: Incident Ticket Table -->
      <div class="table-container" id="incidentTableContainer">
        <table class="table table-striped table-bordered" id="incidentTable">
          <thead>
            <tr>
              <th>Incident Number</th>
              <th>Incident Name</th>
              <th>Incident Time</th>
              <th>Incident Severity</th>
              <th>Incident Type</th>
              <th>SOC Analysis</th>
              <th>SOC Recommendation</th>
              <th>Incident Status</th>
              <th>Incident SubStatus</th>
            </tr>
          </thead>
          <tbody>
            <% incidentTickets.forEach(function(ticket) { %>
              <tr>
                <td>
                  <%= ticket.id %>
                </td>
                <td>
                  <%= ticket.subject %>
                </td>
                <% const date=new Date(ticket.createdDate); const dateStr=date.toLocaleDateString("en-US", {
                  timeZone: "UTC" }); const timeStr=date.toLocaleTimeString("en-US", { timeZone: "UTC" , hour12: true,
                  hour: "numeric" , minute: "2-digit" , second: "2-digit" }); const
                  ms=date.getUTCMilliseconds().toString().padStart(3, "0" ); %>
                  <td>
                    <%= dateStr %><br>
                      <%= timeStr %>.<%= ms %> <br>
                          (UTC)
                  </td>
                  <td>
                    <%= ticket.priority %>
                  </td>
                  <td>
                    <%= ticket.incidentType %>
                  </td>
                  <td>
                    <%= ticket.socAnalysis %>
                  </td>
                  <td>
                    <%= ticket.socRecommendation %>
                  </td>
                  <td>
                    <%= ticket.status && ticket.status.toLowerCase()==='closed' ? 'Resolved' : ticket.status %>
                  </td>
                  <td>
                    <%= ticket.incidentSubStatus %>
                  </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>

        <!-- 12th row: Analysis on Health Ticket Title -->
        <div class="section-title">Analysis on Health Ticket</div>

        <!-- New: Summary for Health Tickets (without date range) -->
        <div class="date-range-summary">
          <div class="date-summary"><%- healthTicketSummary || `System health monitoring identified
              ${healthTickets.length} health incidents with customer escalation.` %></div>
        </div>

        <% if (healthTickets && healthTickets.length> 0) { %>
          <!-- 13th row: Health Ticket Table -->
          <div class="table-container" id="healthTableContainer">

            <table class="table table-striped table-bordered" id="healthTable">
              <thead>
                <tr>
                  <th>Incident Number</th>
                  <th>Incident Name</th>
                  <th>Incident Time</th>
                  <th>Incident Severity</th>
                  <th>Incident Type</th>
                  <th>SOC Analysis</th>
                  <th>SOC Recommendation</th>
                  <th>Incident Status</th>
                  <th>Incident SubStatus</th>
                </tr>
              </thead>
              <tbody>
                <% healthTickets.forEach(function(ticket) { %>
                  <tr>
                    <td>
                      <%= ticket.id %>
                    </td>
                    <td>
                      <%= ticket.subject %>
                    </td>
                    <% const date=new Date(ticket.createdDate); const dateStr=date.toLocaleDateString("en-US", {
                      timeZone: "UTC" }); const timeStr=date.toLocaleTimeString("en-US", { timeZone: "UTC" , hour12:
                      true, hour: "numeric" , minute: "2-digit" , second: "2-digit" }); const
                      ms=date.getUTCMilliseconds().toString().padStart(3, "0" ); %>
                      <td>
                        <%= dateStr %><br>
                          <%= timeStr %>.<%= ms %> <br>
                              (UTC)
                      </td>
                      <td>
                        <%= ticket.priority %>
                      </td>
                      <td>
                        <%= ticket.incidentType %>
                      </td>
                      <td>
                        <%= ticket.socAnalysis %>
                      </td>
                      <td>
                        <%= ticket.socRecommendation %>
                      </td>
                      <td>
                        <%= ticket.status && ticket.status.toLowerCase()==='closed' ? 'Resolved' : ticket.status %>
                      </td>
                      <td>
                        <%= ticket.incidentSubStatus %>
                      </td>
                  </tr>
                  <% }); %>
              </tbody>
            </table>

          </div>
          <% } %>
  </div>

  <!-- Hidden data containers for chart data -->
  <script type="application/json" id="severityChartLabels">
      <%- JSON.stringify(severityChartLabels) %>
    </script>
  <script type="application/json" id="severityChartData">
      <%- JSON.stringify(severityChartData) %>
    </script>
  <script type="application/json" id="detectionChartLabels">
      <%- JSON.stringify(detectionChartLabels) %>
    </script>
  <script type="application/json" id="detectionChartData">
      <%- JSON.stringify(detectionChartData) %>
    </script>
  <script type="application/json" id="handlingStatusChartLabels">
      <%- JSON.stringify(handlingStatusChartLabels) %>
    </script>
  <script type="application/json" id="handlingStatusChartData">
      <%- JSON.stringify(handlingStatusChartData) %>
    </script>
  <script type="application/json" id="subStatusChartLabels">
      <%- JSON.stringify(subStatusChartLabels) %>
    </script>
  <script type="application/json" id="subStatusChartData">
      <%- JSON.stringify(subStatusChartData) %>
    </script>
  <script type="application/json" id="subStatusColors">
      <%- JSON.stringify(subStatusColors) %>
    </script>

  <!-- ✅ NEW: Default detection sources for when no data is available -->
  <script type="application/json" id="defaultDetectionSources">
      <%- JSON.stringify(['Active Directory', 'MDE', 'Entra ID', 'Firewall']) %>
    </script>

  <!-- ✅ NEW: Default sub-status categories for when no data is available -->
  <script type="application/json" id="defaultSubStatusCategories">
      <%- JSON.stringify(['SOC Investigating', 'Awaiting Customer', 'False Positive', 'True Positive']) %>
    </script>

  <script>
    // ✅ PRODUCTION-READY TABLE PAGINATION HELPER
    class TablePaginationHelper {
      constructor() {
        this.estimatedRowHeight = 25; // Estimated height of each row in mm
        this.pageHeight = 297; // A4 height in mm
        this.margins = 30; // Total margins in mm
        this.availableHeight = this.pageHeight - this.margins;
        this.minRowsOnPage = 5; // Minimum rows to keep with section header
      }

      // ✅ OPTIMIZE TABLE FOR PRINT
      optimizeTableForPrint(tableId, containerId) {
        const table = document.getElementById(tableId);
        const container = document.getElementById(containerId);

        if (!table || !container) return;

        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));

        if (rows.length <= 15) return; // Only process tables with more than 15 rows

        // ✅ CREATE CLONE FOR MEASUREMENT
        const clone = table.cloneNode(true);
        clone.style.position = 'absolute';
        clone.style.left = '-9999px';
        clone.style.width = table.offsetWidth + 'px';
        document.body.appendChild(clone);

        // ✅ MEASURE ACTUAL ROW HEIGHT
        const firstRow = clone.querySelector('tbody tr');
        const actualRowHeight = firstRow ? firstRow.offsetHeight / 3.78 : this.estimatedRowHeight; // Convert px to mm

        // ✅ CALCULATE OPTIMAL ROWS PER PAGE
        const headerHeight = 15; // Estimated header height in mm
        const footerHeight = 10; // Estimated footer height in mm
        const availableForRows = this.availableHeight - headerHeight - footerHeight;
        const maxRowsPerPage = Math.floor(availableForRows / actualRowHeight);

        // ✅ CLEAN UP CLONE
        document.body.removeChild(clone);

        // ✅ SPLIT TABLE IF NEEDED
        if (rows.length > maxRowsPerPage) {
          this.splitTable(table, container, rows, maxRowsPerPage);
        }
      }

      // ✅ SPLIT TABLE INTO MULTIPLE SECTIONS
      splitTable(originalTable, container, rows, maxRowsPerPage) {
        const thead = originalTable.querySelector('thead').cloneNode(true);
        const fragment = document.createDocumentFragment();
        let currentTable = null;
        let currentTbody = null;
        let rowCount = 0;

        // ✅ CREATE NEW TABLE FOR EACH PAGE
        const createNewTable = () => {
          currentTable = originalTable.cloneNode(false);
          currentTable.appendChild(thead.cloneNode(true));
          currentTbody = document.createElement('tbody');
          currentTable.appendChild(currentTbody);

          const newContainer = document.createElement('div');
          newContainer.className = 'table-container';
          newContainer.appendChild(currentTable);
          fragment.appendChild(newContainer);

          rowCount = 0;
        };

        // ✅ PROCESS ROWS
        rows.forEach((row, index) => {
          if (rowCount === 0) {
            createNewTable();
          }

          currentTbody.appendChild(row.cloneNode(true));
          rowCount++;

          // ✅ CHECK IF WE NEED A NEW PAGE
          if (rowCount >= maxRowsPerPage && index < rows.length - 1) {
            // Add page break after this table
            const currentContainer = fragment.lastElementChild;
            currentContainer.classList.add('table-page-break');
          }
        });

        // ✅ REMOVE LAST PAGE BREAK
        if (fragment.lastElementChild) {
          fragment.lastElementChild.classList.add('no-break-after');
        }

        // ✅ REPLACE ORIGINAL TABLE
        container.innerHTML = '';
        container.appendChild(fragment);
      }

      // ✅ OPTIMIZE ALL TABLES
      optimizeAllTables() {
        // Only run in print mode or when preparing for print
        if (window.matchMedia) {
          const mediaQueryList = window.matchMedia('print');
          if (mediaQueryList.matches) {
            this.processTables();
          } else {
            // Listen for print dialog
            mediaQueryList.addListener((mql) => {
              if (mql.matches) {
                this.processTables();
              }
            });
          }
        }
      }

      // ✅ PROCESS TABLES WITH DELAY
      processTables() {
        setTimeout(() => {
          if (document.getElementById('incidentTable')) {
            this.optimizeTableForPrint('incidentTable', 'incidentTableContainer');
          }
          if (document.getElementById('healthTable')) {
            this.optimizeTableForPrint('healthTable', 'healthTableContainer');
          }
        }, 100);
      }
    }

    // ✅ INITIALIZE PAGINATION HELPER
    const tableHelper = new TablePaginationHelper();

    // Function to safely parse JSON from script tags
    function getChartData(elementId) {
      try {
        const element = document.getElementById(elementId);
        if (element) {
          const data = JSON.parse(element.textContent);
          console.log(`📊 ${elementId} data:`, data);
          return data;
        }
        return null;
      } catch (error) {
        console.error("Error parsing chart data:", error);
        return null;
      }
    }

    // Get data from hidden script tags
    const severityChartLabels = getChartData("severityChartLabels");
    const severityChartData = getChartData("severityChartData");
    const detectionChartLabels = getChartData("detectionChartLabels");
    const detectionChartData = getChartData("detectionChartData");
    const handlingStatusChartLabels = getChartData("handlingStatusChartLabels");
    const handlingStatusChartData = getChartData("handlingStatusChartData");
    const subStatusChartLabels = getChartData("subStatusChartLabels");
    const subStatusChartData = getChartData("subStatusChartData");
    const subStatusColors = getChartData("subStatusColors");
    const defaultDetectionSources = getChartData("defaultDetectionSources");
    const defaultSubStatusCategories = getChartData("defaultSubStatusCategories");

    // ✅ NEW: Function to set generation date and time in UTC
    function setGenerationDateTime() {
      const now = new Date();
      const dateStr = now.toLocaleDateString("en-US", { timeZone: "UTC" });
      const timeStr = now.toLocaleTimeString("en-US", {
        timeZone: "UTC",
        hour12: true,
        hour: "numeric",
        minute: "2-digit",
        second: "2-digit"
      });
      const ms = now.getUTCMilliseconds().toString().padStart(3, "0");

      const generationDateTime = document.getElementById("generationDateTime");
      if (generationDateTime) {
        generationDateTime.textContent = ` ${dateStr} ${timeStr}.${ms} (UTC)`;
      }
    }

    // Function to create charts
    function createCharts() {
      if (!severityChartLabels || !severityChartData) {
        console.error("Missing severity chart data");
        return;
      }

      console.log("📊 Creating severity chart with labels:", severityChartLabels);
      console.log("📊 Creating severity chart with data:", severityChartData);

      // Custom plugin to draw data labels
      const dataLabelsPlugin = {
        id: 'dataLabels',
        afterDatasetsDraw: function (chart) {
          const ctx = chart.ctx;
          ctx.save();

          chart.data.datasets.forEach(function (dataset, i) {
            const meta = chart.getDatasetMeta(i);
            if (!meta.hidden) {
              meta.data.forEach(function (element, index) {
                const data = dataset.data[index];
                ctx.fillStyle = '#304758';
                ctx.font = '500 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';

                const barTopY = element.y;
                const barCenterX = element.x;

                ctx.fillStyle = '#304758';
                ctx.font = '500 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';

                ctx.fillText(data, barCenterX, barTopY - 6);
              });
            }
          });

          ctx.restore();
        }
      };

      Chart.register(dataLabelsPlugin);

      // Incident by Severity Chart
      const severityCtx = document.getElementById("severityChart");
      if (severityCtx) {
        const severityChart = new Chart(severityCtx.getContext("2d"), {
          type: "bar",
          data: {
            labels: severityChartLabels,
            datasets: [
              {
                label: "High",
                data: severityChartData.high,
                backgroundColor: "#f08080",
                barPercentage: 0.6,
                categoryPercentage: 0.7
              },
              {
                label: "Medium",
                data: severityChartData.medium,
                backgroundColor: "#ffdd57",
                barPercentage: 0.6,
                categoryPercentage: 0.7
              },
              {
                label: "Low",
                data: severityChartData.low,
                backgroundColor: "#7DDA58",
                barPercentage: 0.6,
                categoryPercentage: 0.7
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: {
              duration: 0
            },
            layout: {
              padding: {
                top: 20
              }
            },
            plugins: {
              legend: {
                position: 'bottom',
              },
              tooltip: {
                callbacks: {
                  label: function (context) {
                    return context.dataset.label + ': ' + context.raw + ' incidents';
                  }
                }
              }
            },
            scales: {
              x: {
                stacked: false,
              },
              y: {
                stacked: false,
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Incident Count'
                },
                ticks: {
                  padding: 10,
                  stepSize: 1,
                  callback: function (value) {
                    if (Math.floor(value) === value) {
                      return value;
                    }
                  }
                },
                afterBuildTicks: function (scale) {
                  if (scale.ticks.length > 0) {
                    const maxTick = Math.max(...scale.ticks.map(t => t.value));
                    scale.ticks.push({ value: maxTick + 1, label: '' });
                  }
                }
              }
            }
          },
        });

        console.log("📊 Severity chart created:", severityChart);
      }

      // ✅ FIXED: Incident by Detection Source Chart
      const detectionCtx = document.getElementById("detectionChart");
      if (detectionCtx) {
        // ✅ ENSURE WE HAVE DEFAULT DATA WHEN NO DATA IS AVAILABLE
        let labels = detectionChartLabels;
        let data = detectionChartData;

        // If no data, use default sources with zero values
        if (!labels || !labels.length || !data || !data.high) {
          labels = defaultDetectionSources || ['Active Directory', 'MDE', 'Entra ID', 'Firewall'];
          data = {
            high: new Array(labels.length).fill(0),
            medium: new Array(labels.length).fill(0),
            low: new Array(labels.length).fill(0)
          };
        }

        console.log("📊 Creating detection chart with labels:", labels);
        console.log("📊 Creating detection chart with data:", data);

        new Chart(detectionCtx.getContext("2d"), {
          type: "bar",
          data: {
            labels: labels,
            datasets: [
              {
                label: "High",
                data: data.high,
                backgroundColor: "#f08080",
                barPercentage: 0.7,
                categoryPercentage: 0.8
              },
              {
                label: "Medium",
                data: data.medium,
                backgroundColor: "#ffdd57",
                barPercentage: 0.7,
                categoryPercentage: 0.8
              },
              {
                label: "Low",
                data: data.low,
                backgroundColor: "#7DDA58",
                barPercentage: 0.7,
                categoryPercentage: 0.8
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: {
              duration: 0
            },
            layout: {
              padding: {
                top: 20
              }
            },
            plugins: {
              legend: {
                position: 'bottom',
              },
              tooltip: {
                callbacks: {
                  label: function (context) {
                    return context.dataset.label + ': ' + context.raw + ' incidents';
                  }
                }
              }
            },
            scales: {
              x: {
                stacked: false,
              },
              y: {
                stacked: false,
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Incident Count'
                },
                ticks: {
                  padding: 10,
                  stepSize: 1,
                  callback: function (value) {
                    if (Math.floor(value) === value) {
                      return value;
                    }
                  }
                },
                afterBuildTicks: function (scale) {
                  if (scale.ticks.length > 0) {
                    const maxTick = Math.max(...scale.ticks.map(t => t.value));
                    scale.ticks.push({ value: maxTick + 1, label: '' });
                  }
                }
              },
            },
          },
        });
      }

      // Incident by Handling Status Chart
      const handlingStatusCtx = document.getElementById("handlingStatusChart");
      if (handlingStatusCtx && handlingStatusChartLabels && handlingStatusChartData) {
        new Chart(handlingStatusCtx.getContext("2d"), {
          type: "bar",
          data: {
            labels: handlingStatusChartLabels,
            datasets: [
              {
                label: "In Progress",
                data: handlingStatusChartData.pending,
                backgroundColor: "#ffdd57",
              },
              {
                label: "Resolved",
                data: handlingStatusChartData.resolved,
                backgroundColor: "#70db70",
              }
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: {
              duration: 0
            },
            layout: {
              padding: {
                top: 20
              }
            },
            plugins: {
              legend: {
                position: 'bottom',
              },
              tooltip: {
                callbacks: {
                  label: function (context) {
                    return context.dataset.label + ': ' + context.raw + ' incidents';
                  }
                }
              }
            },
            scales: {
              x: {
                stacked: false,
              },
              y: {
                stacked: false,
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Incident Count'
                },
                ticks: {
                  padding: 10,
                  stepSize: 1,
                  callback: function (value) {
                    if (Math.floor(value) === value) {
                      return value;
                    }
                  }
                },
                afterBuildTicks: function (scale) {
                  if (scale.ticks.length > 0) {
                    const maxTick = Math.max(...scale.ticks.map(t => t.value));
                    scale.ticks.push({ value: maxTick + 1, label: '' });
                  }
                }
              },
            },
          },
        });
      }

      // ✅ FIXED: Incident by Sub Status Chart - Use default Chart.js legend
      // ✅ FIXED: Incident by Sub Status Chart - Use default Chart.js legend
      const subStatusCtx = document.getElementById("subStatusChart");

      if (subStatusCtx) {
        // Define all 4 substatus categories with their exact colors
        const allSubStatuses = [
          { label: "SOC Investigating", color: "#70b5fa" }, // Dark blue
          { label: "Awaiting Customer", color: "#f2a150" }, // Orange
          { label: "False Positive", color: "#70db70" }, // Green
          { label: "True Positive", color: "#f08080" }  // Red
        ];

        // Always use all 4 categories as labels - this ensures they appear on x-axis
        const labels = defaultSubStatusCategories || [
          'SOC Investigating',
          'Awaiting Customer',
          'False Positive',
          'True Positive'
        ];

        // Get the actual data if available
        let data = subStatusChartData;

        // If no data, create array of zeros
        if (!data || !data.length) {
          data = new Array(labels.length).fill(0);
        } else {
          // Ensure we have data for all 4 categories
          const newData = [];
          for (let i = 0; i < labels.length; i++) {
            const label = labels[i];
            const existingIndex = subStatusChartLabels ? subStatusChartLabels.indexOf(label) : -1;
            newData.push(existingIndex >= 0 ? data[existingIndex] : 0);
          }
          data = newData;
        }

        // Match each label to its defined color
        const colors = labels.map(label => {
          const status = allSubStatuses.find(s => s.label === label);
          return status ? status.color : "#556ee6";
        });

        console.log("📊 Creating sub-status chart with labels:", labels);
        console.log("📊 Creating sub-status chart with data:", data);
        console.log("📊 Creating sub-status chart with colors:", colors);

        const subStatusChart = new Chart(subStatusCtx.getContext("2d"), {
          type: "bar",
          data: {
            labels: labels, // This ensures all 4 labels appear on x-axis
            datasets: [
              {
                label: "Incidents",
                data: data,
                backgroundColor: colors,
                barPercentage: 0.6,
                categoryPercentage: 0.7
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 0 },
            layout: {
              padding: {
                top: 20
              }
            },
            plugins: {
              legend: {
                display: true,
                position: 'bottom',
                labels: {
                  color: '#666', // ✅ Set the color for all legend labels
                  generateLabels: function (chart) {
                    const data = chart.data;
                    if (data.labels.length && data.datasets.length) {
                      return data.labels.map((label, i) => ({
                        text: label,
                        fillStyle: data.datasets[0].backgroundColor[i],
                        strokeStyle: data.datasets[0].backgroundColor[i],
                        lineWidth: 0,
                        hidden: false,
                        fontColor: '#666' // ✅ Add fontColor property as well
                      }));
                    }
                    return [];
                  }
                }
              },
              tooltip: {
                callbacks: {
                  label: function (context) {
                    return context.label + ": " + context.raw + " incidents";
                  }
                }
              },

              // Draw value labels above bars
              afterDatasetsDraw: function (chart) {
                const ctx = chart.ctx;
                ctx.save();

                chart.data.datasets.forEach(function (dataset) {
                  const meta = chart.getDatasetMeta(0);
                  if (!meta.hidden) {
                    meta.data.forEach(function (element, index) {
                      const value = dataset.data[index];
                      // Show labels even when value is 0
                      ctx.fillStyle = '#304758';
                      ctx.font = '500 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
                      ctx.textAlign = 'center';
                      ctx.textBaseline = 'bottom';

                      const barTopY = element.y;
                      const barCenterX = element.x;

                      ctx.fillText(value, barCenterX, barTopY - 6);
                    });
                  }
                });

                ctx.restore();
              }
            },

            scales: {
              y: {
                beginAtZero: true,
                title: { display: true, text: 'Incident Count' },
                ticks: {
                  padding: 10,
                  stepSize: 1,
                  callback: function (value) {
                    if (Math.floor(value) === value) return value;
                  }
                },
                afterBuildTicks: function (scale) {
                  if (scale.ticks.length > 0) {
                    const maxTick = Math.max(...scale.ticks.map(t => t.value));
                    scale.ticks.push({ value: maxTick + 1, label: '' });
                  }
                }
              },
              x: {
                // ✅ Force all labels to show on x-axis
                ticks: {
                  autoSkip: false, // Don't skip any labels
                  maxRotation: 45, // Allow rotation if needed
                  minRotation: 0,
                  callback: function (value, index, values) {
                    const label = this.getLabelForValue(value);
                    // Wrap long labels
                    if (label.length > 15) {
                      return label.split(' ');
                    }
                    return label;
                  }
                }
              }
            }
          }
        });
      }
    }

    // ✅ PRODUCTION-READY INITIALIZATION
    function initializePage() {
      setGenerationDateTime(); // Set generation date/time
      createCharts();

      // ✅ OPTIMIZE TABLES FOR PRINT
      // Add a small delay to ensure DOM is fully rendered
      setTimeout(() => {
        tableHelper.optimizeAllTables();
      }, 500);

      // ✅ ALSO OPTIMIZE WHEN PRINT DIALOG IS OPENED
      window.addEventListener('beforeprint', () => {
        tableHelper.processTables();
      });
    }

    // Initialize page when DOM is loaded
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializePage);
    } else {
      initializePage();
    }
  </script>

       const subStatusCtx = document.getElementById("subStatusChart");

if (subStatusCtx) {
  const allSubStatuses = [
    { label: "SOC Investigating", color: "#66b2ff", statusType: "In Progress" },
    { label: "Tuning", color: "#ffdd57", statusType: "In Progress" },
    { label: "Awaiting Customer Response", color: "#e6ad57", statusType: "In Progress" },
    { label: "False Positive", color: "#70db70", statusType: "Resolved" },
    { label: "True Positive", color: "#f08080", statusType: "Resolved" }
  ];

  let labels = subStatusChartLabels;
  let data = subStatusChartData;

  if (!labels || !labels.length || !data || !data.length) {
    labels = defaultSubStatusCategories || [
      "SOC Investigating",
      "Tuning",
      "Awaiting Customer Response",
      "False Positive",
      "True Positive"
    ];
    data = new Array(labels.length).fill(0);
  }

  const colors = labels.map(label => {
    const status = allSubStatuses.find(s => s.label === label);
    return status ? status.color : "#556ee6";
  });

 const subStatusChart = new Chart(subStatusCtx.getContext("2d"), {
    type: "bar",
    data: {
      labels,
      datasets: [
        {
          label: "Incidents",
          data,
          backgroundColor: colors,
          barPercentage: 0.6,
          categoryPercentage: 0.7
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 0 },
      plugins: {
        datalabels: { display: false },
        legend: {
          display: true,
          position: "bottom",
          width: 500, // Allow legend to take more width
          marginTop:10, 
          labels: {
            padding: 10, // Increased padding for more space
            generateLabels: chart => {
              const data = chart.data;
              if (data.labels.length && data.datasets.length) {
                return data.labels.map((label, i) => ({
                  text: `${allSubStatuses.find(s => s.label === label)?.statusType || ""} ${label}`,
                  fillStyle: data.datasets[0].backgroundColor[i],
                  strokeStyle: data.datasets[0].backgroundColor[i],
                  lineWidth: 0,
                  fontColor: "#666666"
                }));
              }
              return [];
            }
          }
        },
        tooltip: {
          callbacks: {
            label: context => {
              const status = allSubStatuses.find(s => s.label === context.label);
              const statusType = status ? status.statusType : "";
              return `${statusType} ${context.label}: ${context.raw} incidents`;
            }
          }
        },
        afterDatasetsDraw(chart) {
          const ctx = chart.ctx;
          ctx.save();
          chart.data.datasets.forEach(dataset => {
            const meta = chart.getDatasetMeta(0);
            if (!meta.hidden) {
              meta.data.forEach((element, index) => {
                const value = dataset.data[index];
                if (value > 0) {
                  ctx.fillStyle = "#304758";
                  ctx.font = '500 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
                  ctx.textAlign = "center";
                  ctx.textBaseline = "bottom";
                  ctx.fillText(value, element.x, element.y - 6);
                }
              });
            }
          });
          ctx.restore();
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: { display: true, text: "Incident Count" },
          ticks: {
            padding: 10,
            stepSize: 1,
            callback(value) {
              if (Math.floor(value) === value) return value;
            }
          }
        },
        x: {
          ticks: {
            callback(value) {
              const label = this.getLabelForValue(value);
              if (label.length > 12) {
                const words = label.split(" ");
                let lines = [];
                let currentLine = words[0];
                for (let i = 1; i < words.length; i++) {
                  const word = words[i];
                  if ((currentLine + " " + word).length <= 12) {
                    currentLine += " " + word;
                  } else {
                    lines.push(currentLine);
                    currentLine = word;
                  }
                }
                if (currentLine) lines.push(currentLine);
                return lines;
              }
              return label;
            }
          }
        }
      }
    },

    // ✅ Plugin for group labels + dividers
    plugins: [
      {
        id: "groupLabelsWithDividers",
        afterDraw(chart) {
          const { ctx, chartArea, scales } = chart;
          const xAxis = scales.x;
          const bottomY = chartArea.bottom;

          const groups = [];
          const inProgressIndices = labels
            .map((label, i) => ({ label, i }))
            .filter(item => allSubStatuses.find(s => s.label === item.label)?.statusType === "In Progress")
            .map(item => item.i);

          const resolvedIndices = labels
            .map((label, i) => ({ label, i }))
            .filter(item => allSubStatuses.find(s => s.label === item.label)?.statusType === "Resolved")
            .map(item => item.i);

          if (inProgressIndices.length)
            groups.push({
              label: "In Progress",
              start: inProgressIndices[0],
              end: inProgressIndices[inProgressIndices.length - 1]
            });

          if (resolvedIndices.length)
            groups.push({
              label: "Resolved",
              start: resolvedIndices[0],
              end: resolvedIndices[resolvedIndices.length - 1]
            });

          ctx.save();
          ctx.font = '12px';
          ctx.fillStyle = "#666666";
          ctx.textAlign = "center";
          ctx.textBaseline = "top";

          const labelOffsetY = 70; // ⬆️ Moved further down (from 50 to 70)
          const lineTop = bottomY + 10;
          const lineBottom = bottomY + 68; // ⬆️ Taller lines

          groups.forEach((g, idx) => {
            const barWidth = xAxis.width / labels.length;
            const startX = xAxis.getPixelForValue(g.start) - barWidth / 2;
            const endX = xAxis.getPixelForValue(g.end) + barWidth / 2;
            const midX = (startX + endX) / 2;

            // Draw left divider
            ctx.strokeStyle = "#666666";
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.moveTo(startX, lineTop);
            ctx.lineTo(startX, lineBottom);
            ctx.stroke();

            // Draw right divider
            ctx.beginPath();
            ctx.moveTo(endX, lineTop);
            ctx.lineTo(endX, lineBottom);
            ctx.stroke();

            // Draw bottom label
            ctx.fillText(g.label, midX, bottomY + labelOffsetY);
          });

          // Outer border lines (start & end of x-axis)
          ctx.beginPath();
          ctx.moveTo(chartArea.left, lineTop);
          ctx.lineTo(chartArea.left, lineBottom);
          ctx.moveTo(chartArea.right, lineTop);
          ctx.lineTo(chartArea.right, lineBottom);
          ctx.stroke();

          ctx.restore();
        }
      }
    ]
  });

}
}

      // ✅ PRODUCTION-READY INITIALIZATION
      function initializePage() {
        updateDateRanges();
        createCharts();
        
        // ✅ OPTIMIZE TABLES FOR PRINT
        // Add a small delay to ensure DOM is fully rendered
        setTimeout(() => {
          tableHelper.optimizeAllTables();
        }, 500);
        
        // ✅ ALSO OPTIMIZE WHEN PRINT DIALOG IS OPENED
        window.addEventListener('beforeprint', () => {
          tableHelper.processTables();
        });
      }

      // Initialize page when DOM is loaded
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializePage);
      } else {
        initializePage();
      }
    </script>
